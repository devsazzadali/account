# AccountStoreOne — environment template. Copy to .env.local and fill in.
# Never commit a filled-in .env file.

# Database (Neon Postgres via Prisma)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth (Neon Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Card payments (Stripe) — optional; without these, card checkout is disabled
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend) — transactional order/delivery mail
RESEND_API_KEY=
RESEND_FROM=

# Store fallbacks (admin Settings in the DB take precedence when set)
STORE_NAME=AccountStoreOne
STORE_SUPPORT_EMAIL=
STORE_PAYMENT_NUMBER=
STORE_PAYMENT_INSTRUCTIONS=

# First-admin bootstrap (one-time, see README)
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=
