// AccountStoreOne — Prisma schema (Boss, 2026-10-26)
// Backend migration: Supabase → Prisma + Neon Postgres.
// Modeled from (1) MASTER_PRODUCTION_SCHEMA.sql (the designed model) and
// (2) the columns the app code actually reads/writes (code wins on conflicts —
// e.g. products.category is a category NAME in code, orders carry
// customer_email/username + credential_* fields from checkout/OrderPage).
// Auth is Neon Auth: profiles.id stores the Neon Auth user id (no FK).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum EscrowState {
  pending_payment
  paid
  in_escrow
  processing
  delivered
  completed
  disputed
  refunded
}

model Profile {
  id                String   @id // Neon Auth user id
  username          String?  @unique
  email             String?
  fullName          String?  @map("full_name")
  bio               String?
  isPremium         Boolean  @default(false) @map("is_premium")
  avatarUrl         String?  @map("avatar_url")
  role              String   @default("user") // user | moderator | admin (single-seller: no seller role in use)
  mustResetPassword Boolean  @default(false) @map("must_reset_password")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  orders            Order[]
  wallet            Wallet?
  disputes          Dispute[]
  riskProfile       UserRiskProfile?
  notifications     Notification[]

  @@map("profiles")
}

model Category {
  id             String   @id @default(uuid())
  name           String
  slug           String?  @unique
  description    String?
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  h1Title        String?  @map("h1_title")
  contentBody    String?  @map("content_body")
  faqData        Json     @default("[]") @map("faq_data")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  title       String
  price       Decimal  @db.Decimal(10, 2)
  image       String?
  originalImage String? @map("original_image")
  stock       Int      @default(0)
  category    String? // category name, as the code uses it
  game        String?
  gameType    String?  @map("game_type")
  badge       String?
  sold        Int      @default(0)
  description String?
  seoKeywords String?  @map("seo_keywords")
  createdAt   DateTime @default(now()) @map("created_at")

  orders    Order[]
  inventory Inventory[]
  reviews   Review[]

  @@map("products")
}

model Order {
  id                 String      @id @default(uuid())
  productId          String?     @map("product_id")
  product            Product?    @relation(fields: [productId], references: [id])
  userId             String?     @map("user_id")
  user               Profile?    @relation(fields: [userId], references: [id])
  username           String?
  customerEmail      String?     @map("customer_email")
  quantity           Int         @default(1)
  totalPrice         Decimal     @map("total_price") @db.Decimal(10, 2)
  status             String      @default("New Order") // UI state machine (code truth)
  paymentStatus      String      @default("pending") @map("payment_status")
  paymentMethod      String?     @map("payment_method")
  escrowState        EscrowState @default(pending_payment) @map("escrow_state")
  escrowHoldUntil    DateTime?   @map("escrow_hold_until")
  fundsReleasedAt    DateTime?   @map("funds_released_at")
  disputedAt         DateTime?   @map("disputed_at")
  credentialUsername String?     @map("credential_username")
  credentialPassword String?     @map("credential_password")
  credentialNotes    String?     @map("credential_notes")
  stripeSessionId    String?     @unique @map("stripe_session_id")
  paymentIntentId    String?     @map("payment_intent_id")
  idempotencyKey     String?     @unique @map("idempotency_key") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  inventory Inventory[]
  dispute   Dispute?

  @@index([userId])
  @@map("orders")
}

model Inventory {
  id                String    @id @default(uuid())
  productId         String?   @map("product_id")
  product           Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  accountLogin      String    @map("account_login")
  accountPassword   String    @map("account_password")
  twoFactorSecret   String?   @map("two_factor_secret")
  cookies           String?
  recoveryEmail     String?   @map("recovery_email")
  additionalInfo    String?   @map("additional_info")
  status            String    @default("available") // available | assigned | used | failed | flagged | sold
  isHealthy         Boolean   @default(true) @map("is_healthy")
  lastVerifiedAt    DateTime  @default(now()) @map("last_verified_at")
  orderId           String?   @map("order_id")
  order             Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedAt        DateTime? @map("assigned_at")
  reservedUntil     DateTime? @map("reserved_until")
  reservedBySession String?   @map("reserved_by_session_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([productId, status])
  @@map("inventory")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String?  @map("wallet_id")
  wallet      Wallet?  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  type        String // deposit | purchase | refund | withdrawal | bonus
  status      String   @default("completed")
  method      String? // bkash | nagad | wallet | stripe
  trxId       String?  @map("trx_id")
  note        String?
  referenceId String?  @map("reference_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("wallet_transactions")
}

model Dispute {
  id         String   @id @default(uuid())
  orderId    String?  @unique @map("order_id")
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id")
  user       Profile? @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("open") // open | under_review | mediation | resolved | closed
  resolution String? // refunded | replaced | rejected | canceled
  prevStatus String?  @map("prev_status")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("disputes")
}

model UserRiskProfile {
  userId              String   @id @map("user_id")
  user                Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentScore        Int      @default(0) @map("current_score")
  isBlocked           Boolean  @default(false) @map("is_blocked")
  totalFailedPayments Int      @default(0) @map("total_failed_payments")
  lastDetectedIp      String?  @map("last_detected_ip")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("user_risk_profiles")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  action      String
  targetTable String?  @map("target_table")
  targetId    String?  @map("target_id") @db.Uuid
  oldData     Json?    @map("old_data")
  newData     Json?    @map("new_data")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      Profile? @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Message {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  username  String
  subject   String?
  message   String
  reply     String?
  status    String   @default("unread") // unread | replied
  createdAt DateTime @default(now()) @map("created_at")

  @@map("messages")
}

/// Manual payment submissions (bKash/Nagad) awaiting admin verification.
/// Used both for order payments (orderId set) and wallet top-ups (orderId null).
model PaymentRequest {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  orderId      String?   @map("order_id")
  purpose      String // order | topup
  method       String // bkash | nagad
  amount       Decimal   @db.Decimal(12, 2)
  trxId        String    @map("trx_id")
  senderNumber String?   @map("sender_number")
  status       String    @default("pending") // pending | approved | rejected
  adminNote    String?   @map("admin_note")
  createdAt    DateTime  @default(now()) @map("created_at")
  reviewedAt   DateTime? @map("reviewed_at")

  @@index([status])
  @@index([orderId])
  @@map("payment_requests")
}

/// Key/value store settings, editable from the admin Settings screen.
/// Secrets (Stripe keys, DB URLs) are NEVER stored here — env only.
model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model Review {
  id        String   @id @default(uuid())
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  username  String?
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}
