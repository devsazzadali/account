# AccountStoreOne — environment template. Copy to .env.local and fill in.
# Never commit a filled-in .env file.

# Database (Neon Postgres via Prisma)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth (Neon Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment methods are managed by the admin in the dashboard
# (Settings → Payments): Stripe keys and PayPal credentials are stored
# server-side from there. The env vars below remain as optional
# FALLBACKS — without credentials in either place, card checkout is
# disabled and buyers pay from their store wallet.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Email (Resend) — transactional order/delivery mail
RESEND_API_KEY=
RESEND_FROM=

# Store fallbacks (admin Settings in the DB take precedence when set)
STORE_NAME=AccountStoreOne
STORE_SUPPORT_EMAIL=

# First-admin bootstrap (one-time, see README)
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=
